{
  "name": "API Rate Limiter Interview",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    "ghcr.io/devcontainers/features/go:1": { "version": "1.21" },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/java:1": { "version": "17", "installMaven": "true" },
    "ghcr.io/devcontainers/features/dotnet:2": { "version": "10.0" },
    "ghcr.io/devcontainers/features/rust:1": {},
  },
  "postCreateCommand": "bash scripts/install.sh all || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "MS-vsliveshare.vsliveshare",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "golang.go",
        "ms-python.python",
        "ms-python.debugpy",
        "vscjava.vscode-java-pack",
        "ms-dotnettools.csharp",
        "vitest.explorer",
        "rust-lang.rust-analyzer",
        "rebornix.ruby",
        "fwcd.kotlin"
      ]
    }
  },
  "forwardPorts": []
}
