{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run TypeScript tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test"],
      "cwd": "${workspaceFolder}/typescript",
      "console": "integratedTerminal"
    },
    {
      "name": "Debug TypeScript tests (Vitest)",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "test", "--", "--inspect-brk"],
      "cwd": "${workspaceFolder}/typescript",
      "console": "integratedTerminal",
      "outputCapture": "std"
    },
    {
      "name": "Run Go tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["${workspaceFolder}/scripts/run-go-tests.sh"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Python tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}/python",
      "console": "integratedTerminal"
    },
    {
      "name": "Run Java tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["${workspaceFolder}/scripts/run-java-tests.sh"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Run C# tests",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["${workspaceFolder}/scripts/run-csharp-tests.sh"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
